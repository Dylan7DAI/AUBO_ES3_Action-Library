# Copy this file to .env.local only if you prefer environment variables.
# PowerShell example:
#   Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^([^#][^=]*)=(.*)$') { Set-Item -Path "Env:$($matches[1])" -Value $matches[2] }
#   }
AUBO_ROBOT_IP=192.168.2.1
AUBO_ROBOT_PORT=30004
AUBO_USERNAME=aubo
AUBO_PASSWORD=CHANGE_ME
AUBO_REQUEST_TIMEOUT_MS=3000

# Study runtime. Formal studies should use a long random researcher token.
AUBO_ROBOT_MODE=mock
AUBO_RESEARCHER_TOKEN=CHANGE_ME
AUBO_LOG_ROOT=logs
# Required only when starting the OpenAI LLM condition. Never commit the real value.
OPENAI_API_KEY=
